<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardUseCompatPadding="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/info_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/action_layout"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemAdminContact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên (Nguyễn Văn A)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"/>

            <TextView
                android:id="@+id/tvItemAdminDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date-time (18:00 - 20/12/2025)"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvItemAdminPeople"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Số lượng: 5 người"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/action_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnItemConfirm"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_save"
                app:tint="#4CAF50"
                android:contentDescription="Xác nhận"/> <ImageButton
            android:id="@+id/btnItemCancel"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#F44336"
            android:contentDescription="Hủy"/> </LinearLayout>

    </RelativeLayout>
</androidx.cardview.widget.CardView>